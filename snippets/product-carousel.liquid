{% doc %}
  Renders an editorial product carousel with touch swipe, arrow navigation,
  collection source, and NEW badge logic.
  @param {collection} [collection] - Target collection to display
  @param {number} [products_to_show] - Maximum number of products to show
  @param {string} [title] - Custom section heading
  @param {string} [kicker] - Custom pre-heading kicker
{% enddoc %}

{%- liquid
  assign target_collection = collection | default: collections.all
  assign limit = products_to_show | default: 6
  assign carousel_heading = title | default: target_collection.title | default: 'sections.new_arrivals' | t
  assign carousel_kicker = kicker | default: 'sections.featured_collection' | t
-%}

<product-carousel class="product-carousel">
  <div class="product-carousel__header">
    <div class="product-carousel__headings">
      {%- if carousel_kicker != blank -%}
        <span class="product-carousel__kicker">{{ carousel_kicker }}</span>
      {%- endif -%}
      <h2 class="product-carousel__title">{{ carousel_heading }}</h2>
    </div>

    <div class="product-carousel__controls">
      {%- if target_collection != blank -%}
        <a href="{{ target_collection.url }}" class="product-carousel__view-all">
          {{ 'sections.view_all' | t }}
        </a>
      {%- endif -%}

      <div class="product-carousel__nav-btns">
        <button
          type="button"
          class="carousel-nav-btn carousel-nav-btn--prev"
          aria-label="{{ 'accessibility.previous' | t }}"
          data-direction="prev"
        >
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button
          type="button"
          class="carousel-nav-btn carousel-nav-btn--next"
          aria-label="{{ 'accessibility.next' | t }}"
          data-direction="next"
        >
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>
    </div>
  </div>

  <div class="product-carousel__track-container">
    <div class="product-carousel__track" role="list" tabindex="0">
      {%- if target_collection != blank and target_collection.products_count > 0 -%}
        {%- for product in target_collection.products limit: limit -%}
          <div class="product-carousel__slide" role="listitem">
            {% render 'product-card',
              product: product,
              sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 35vw, 70vw'
            %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- # Graceful placeholder preview if collection is empty -%}
        {%- for i in (1..limit) -%}
          <div class="product-carousel__slide" role="listitem">
            <div class="product-card">
              <div class="product-card__media-wrapper">
                <div class="product-card__placeholder">
                  {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                  {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">
                  <a href="#">Maison Atelier Garment {{ i }}</a>
                </h3>
                <div class="price">
                  <span class="price-item price-item--regular">$480.00</span>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</product-carousel>
