{% doc %}
  Renders currency/country and language selector forms using Shopify's localization form.
{% enddoc %}

{%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  <div class="localization-selectors">
    {%- form 'localization', id: 'LocalizationForm', class: 'localization-form' -%}
      {%- if localization.available_countries.size > 1 -%}
        <div class="localization-form__select">
          <label for="LocalizationCountrySelector" class="visually-hidden">
            {{ 'footer.country_region' | t }}
          </label>
          <div class="select-wrapper">
            <select
              id="LocalizationCountrySelector"
              name="country_code"
              class="localization-form__dropdown"
              onchange="this.form.submit()"
            >
              {%- for country in localization.available_countries -%}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down', class: 'select-arrow' %}
          </div>
        </div>
      {%- endif -%}

      {%- if localization.available_languages.size > 1 -%}
        <div class="localization-form__select">
          <label for="LocalizationLanguageSelector" class="visually-hidden">
            {{ 'footer.language' | t }}
          </label>
          <div class="select-wrapper">
            <select
              id="LocalizationLanguageSelector"
              name="language_code"
              class="localization-form__dropdown"
              onchange="this.form.submit()"
            >
              {%- for language in localization.available_languages -%}
                <option
                  value="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ language.endonym_name | capitalize }}
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down', class: 'select-arrow' %}
          </div>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endif -%}
