{% doc %}
  Renders an editorial newsletter subscription section with customer tags and status messages.

  @param {string} [kicker] - Sub-heading kicker text
  @param {string} [heading] - Newsletter section heading
  @param {string} [subheading] - Newsletter section subheading
{% enddoc %}

{%- liquid
  assign nl_kicker = kicker | default: 'Join the Circle'
  assign nl_heading = heading | default: 'sections.newsletter_title' | t
  assign nl_subheading = subheading | default: 'sections.newsletter_subtitle' | t
-%}

<div class="newsletter-section">
  <div class="newsletter-section__inner">
    {%- if nl_kicker != blank -%}
      <span class="newsletter-section__kicker">{{ nl_kicker }}</span>
    {%- endif -%}

    <h2 class="newsletter-section__heading">
      {{ nl_heading }}
    </h2>

    <p class="newsletter-section__subheading">
      {{ nl_subheading }}
    </p>

    {%- form 'customer', id: 'HomeNewsletterForm', class: 'newsletter-section__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,homepage">

      <div class="newsletter-section__field-row">
        <label for="HomeNewsletterEmail" class="visually-hidden">
          {{ 'footer.email_placeholder' | t }}
        </label>
        <input
          id="HomeNewsletterEmail"
          type="email"
          name="contact[email]"
          class="newsletter-section__input"
          value="{{ form.email }}"
          placeholder="{{ 'footer.email_placeholder' | t }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
        >
        <button
          type="submit"
          class="button button--newsletter"
        >
          {{ 'footer.subscribe' | t }}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" tabindex="-1" autofocus>
          {% render 'icon', name: 'check' %}
          {{ 'footer.success_message' | t }}
        </p>
      {%- elsif form.errors -%}
        <p class="form-status form-status--error" tabindex="-1" autofocus>
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
