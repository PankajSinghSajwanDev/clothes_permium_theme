[
  {
    "name": "theme_info",
    "theme_name": "Maison",
    "theme_version": "1.0.0",
    "theme_author": "Maison Studio",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "garamond_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 32
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#0A0A0A",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#C8A97E",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E8E8E8",
        "label": "t:labels.border_color"
      }
    ]
  },
  {
    "name": "t:general.header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_image",
        "label": "t:labels.logo_image"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "t:labels.logo_max_width",
        "default": 140
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_header",
        "label": "t:labels.enable_sticky_header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "hide_header_on_scroll",
        "label": "t:labels.hide_header_on_scroll",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.announcement_bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_enabled",
        "label": "t:labels.announcement_enabled",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text_1",
        "label": "t:labels.announcement_text_1",
        "default": "Complimentary Worldwide Express Delivery on Orders Over $300"
      },
      {
        "type": "url",
        "id": "announcement_link_1",
        "label": "t:labels.announcement_link_1"
      },
      {
        "type": "text",
        "id": "announcement_text_2",
        "label": "t:labels.announcement_text_2",
        "default": "New Edition — Autumn / Winter Capsule Available Now"
      },
      {
        "type": "url",
        "id": "announcement_link_2",
        "label": "t:labels.announcement_link_2"
      },
      {
        "type": "color",
        "id": "announcement_bg",
        "label": "t:labels.announcement_bg",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "t:labels.announcement_text_color",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "t:general.footer",
    "settings": [
      {
        "type": "text",
        "id": "footer_heading",
        "label": "t:labels.footer_heading",
        "default": "MAISON"
      },
      {
        "type": "textarea",
        "id": "footer_description",
        "label": "t:labels.footer_description",
        "default": "An independent atelier crafting architectural silhouettes in refined natural textiles. Designed with intention, made to endure."
      },
      {
        "type": "checkbox",
        "id": "show_newsletter",
        "label": "t:labels.show_newsletter",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "t:labels.show_payment_icons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_social_icons",
        "label": "t:labels.show_social_icons",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "t:labels.instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "t:labels.tiktok"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "t:labels.pinterest"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "t:labels.facebook"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "t:labels.twitter"
      }
    ]
  },
  {
    "name": "t:general.cookie_banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cookie_banner",
        "label": "t:labels.enable_cookie_banner",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "t:labels.enable_animations",
        "default": true
      }
    ]
  }
]
