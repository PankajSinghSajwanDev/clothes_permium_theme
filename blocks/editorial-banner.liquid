{% doc %}
  Renders a full-width or inset editorial lookbook banner with atmospheric imagery,
  kicker, heading, narrative paragraph, and call-to-action link.
{% enddoc %}

<div class="editorial-banner full-width" {{ block.shopify_attributes }}>
  <div class="editorial-banner__media">
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 2000 | image_tag:
        class: 'editorial-banner__img',
        widths: '750, 1100, 1500, 2000',
        sizes: '100vw',
        loading: 'lazy',
        alt: block.settings.heading | default: shop.name | escape
      }}
    {%- else -%}
      <div class="editorial-banner__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="editorial-banner__overlay"></div>
  </div>

  <div class="editorial-banner__container">
    <div class="editorial-banner__content editorial-banner__content--{{ block.settings.text_alignment | default: 'left' }}">
      {%- if block.settings.kicker != blank -%}
        <span class="editorial-banner__kicker">{{ block.settings.kicker }}</span>
      {%- endif -%}

      {%- if block.settings.heading != blank -%}
        <h2 class="editorial-banner__heading">{{ block.settings.heading }}</h2>
      {%- endif -%}

      {%- if block.settings.text != blank -%}
        <p class="editorial-banner__text">{{ block.settings.text }}</p>
      {%- endif -%}

      {%- if block.settings.button_label != blank -%}
        <a
          href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
          class="button button--editorial"
        >
          {{ block.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.editorial_banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker",
      "default": "Atelier Lookbook — Vol. 04"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The Form of Quietude"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.subheading",
      "default": "Captured in the raw coastal light of Normandy. Monochromatic tailoring, double-faced cashmere overcoats, and Japanese raw denim."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "View the Lookbook"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ]
}
{% endschema %}
