{% doc %}
  Renders a centered editorial rich text block with kicker, architectural heading,
  narrative philosophy copy, and an optional button link.
{% enddoc %}

<div class="rich-text rich-text--align-{{ block.settings.alignment | default: 'center' }}" {{ block.shopify_attributes }}>
  <div class="rich-text__inner">
    {%- if block.settings.kicker != blank -%}
      <span class="rich-text__kicker">{{ block.settings.kicker }}</span>
    {%- endif -%}

    {%- if block.settings.heading != blank -%}
      <h2 class="rich-text__heading">{{ block.settings.heading }}</h2>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="rich-text__body">
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endif -%}

    {%- if block.settings.button_label != blank -%}
      <div class="rich-text__cta">
        <a
          href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
          class="button button--secondary"
        >
          {{ block.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.rich_text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker",
      "default": "The Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Made to Endure, Designed with Intention"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.subheading",
      "default": "Each garment originates from a dialogue between raw organic material and structural discipline. We eliminate unnecessary ornament to honor proportion, drape, and tactile longevity."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "About the Atelier"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ]
}
{% endschema %}
