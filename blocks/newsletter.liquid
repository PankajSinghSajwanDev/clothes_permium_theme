{% doc %}
  Renders an editorial newsletter subscription section with customer tags and status messages.
{% enddoc %}

<div class="newsletter-section" {{ block.shopify_attributes }}>
  <div class="newsletter-section__inner">
    {%- if block.settings.kicker != blank -%}
      <span class="newsletter-section__kicker">{{ block.settings.kicker }}</span>
    {%- endif -%}

    <h2 class="newsletter-section__heading">
      {{ block.settings.heading | default: 'sections.newsletter_title' | t }}
    </h2>

    <p class="newsletter-section__subheading">
      {{ block.settings.subheading | default: 'sections.newsletter_subtitle' | t }}
    </p>

    {%- form 'customer', id: 'HomeNewsletterForm', class: 'newsletter-section__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,homepage">

      <div class="newsletter-section__field-row">
        <label for="HomeNewsletterEmail" class="visually-hidden">
          {{ 'footer.email_placeholder' | t }}
        </label>
        <input
          id="HomeNewsletterEmail"
          type="email"
          name="contact[email]"
          class="newsletter-section__input"
          value="{{ form.email }}"
          placeholder="{{ 'footer.email_placeholder' | t }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
        >
        <button
          type="submit"
          class="button button--newsletter"
        >
          {{ 'footer.subscribe' | t }}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" tabindex="-1" autofocus>
          {% render 'icon', name: 'check' %}
          {{ 'footer.success_message' | t }}
        </p>
      {%- elsif form.errors -%}
        <p class="form-status form-status--error" tabindex="-1" autofocus>
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker",
      "default": "Join the Circle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Private Invitations & Release Access"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Subscribers receive inaugural capsule preview access, private salon appointments, and editorial monographs."
    }
  ]
}
{% endschema %}
