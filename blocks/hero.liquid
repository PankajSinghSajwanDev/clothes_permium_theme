{% doc %}
  Renders a full-bleed editorial hero block with 1-up or 2-up split layouts,
  mobile image variants, preloaded LCP image optimization, and editorial typography.
{% enddoc %}

{%- liquid
  assign hero_layout = block.settings.layout | default: '1-up'
  assign alignment = block.settings.alignment | default: 'center'
-%}

<div
  class="hero-section hero-section--{{ hero_layout }} full-width"
  style="--hero-overlay-opacity: {{ block.settings.overlay_opacity | default: 20 | divided_by: 100.0 }};"
  {{ block.shopify_attributes }}
>
  {%- # Tile 1 -%}
  <div class="hero-tile hero-tile--1 hero-tile--align-{{ alignment }}">
    <div class="hero-tile__media">
      {%- if block.settings.image_1 != blank -%}
        <picture>
          {%- if block.settings.image_mobile_1 != blank -%}
            <source
              media="(max-width: 767px)"
              srcset="{{ block.settings.image_mobile_1 | image_url: width: 750 }} 1x, {{ block.settings.image_mobile_1 | image_url: width: 1500 }} 2x"
            >
          {%- endif -%}
          {{ block.settings.image_1 | image_url: width: 2400 | image_tag:
            class: 'hero-tile__image',
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            fetchpriority: 'high',
            loading: 'eager',
            alt: block.settings.heading_1 | default: shop.name | escape
          }}
        </picture>
      {%- else -%}
        <div class="hero-tile__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      <div class="hero-tile__overlay"></div>
    </div>

    <div class="hero-tile__content">
      {%- if block.settings.kicker_1 != blank -%}
        <span class="hero-tile__kicker">{{ block.settings.kicker_1 }}</span>
      {%- endif -%}

      {%- if block.settings.heading_1 != blank -%}
        <h2 class="hero-tile__heading">{{ block.settings.heading_1 }}</h2>
      {%- endif -%}

      {%- if block.settings.subheading_1 != blank -%}
        <p class="hero-tile__subheading">{{ block.settings.subheading_1 }}</p>
      {%- endif -%}

      {%- if block.settings.button_label_1 != blank -%}
        <div class="hero-tile__cta-wrap">
          <a
            href="{{ block.settings.button_link_1 | default: routes.all_products_collection_url }}"
            class="button button--hero"
          >
            {{ block.settings.button_label_1 }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- # Tile 2 (if 2-up layout) -%}
  {%- if hero_layout == '2-up' -%}
    <div class="hero-tile hero-tile--2 hero-tile--align-{{ alignment }}">
      <div class="hero-tile__media">
        {%- if block.settings.image_2 != blank -%}
          <picture>
            {%- if block.settings.image_mobile_2 != blank -%}
              <source
                media="(max-width: 767px)"
                srcset="{{ block.settings.image_mobile_2 | image_url: width: 750 }} 1x, {{ block.settings.image_mobile_2 | image_url: width: 1500 }} 2x"
              >
            {%- endif -%}
            {{ block.settings.image_2 | image_url: width: 1600 | image_tag:
              class: 'hero-tile__image',
              widths: '750, 1100, 1600',
              sizes: '(min-width: 768px) 50vw, 100vw',
              loading: 'lazy',
              alt: block.settings.heading_2 | default: shop.name | escape
            }}
          </picture>
        {%- else -%}
          <div class="hero-tile__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        <div class="hero-tile__overlay"></div>
      </div>

      <div class="hero-tile__content">
        {%- if block.settings.kicker_2 != blank -%}
          <span class="hero-tile__kicker">{{ block.settings.kicker_2 }}</span>
        {%- endif -%}

        {%- if block.settings.heading_2 != blank -%}
          <h2 class="hero-tile__heading">{{ block.settings.heading_2 }}</h2>
        {%- endif -%}

        {%- if block.settings.subheading_2 != blank -%}
          <p class="hero-tile__subheading">{{ block.settings.subheading_2 }}</p>
        {%- endif -%}

        {%- if block.settings.button_label_2 != blank -%}
          <div class="hero-tile__cta-wrap">
            <a
              href="{{ block.settings.button_link_2 | default: routes.all_products_collection_url }}"
              class="button button--hero"
            >
              {{ block.settings.button_label_2 }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout_direction",
      "options": [
        {
          "value": "1-up",
          "label": "t:options.hero_layout.single"
        },
        {
          "value": "2-up",
          "label": "t:options.hero_layout.split"
        }
      ],
      "default": "1-up"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:labels.tile_1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_1",
      "label": "t:labels.mobile_image"
    },
    {
      "type": "text",
      "id": "kicker_1",
      "label": "t:labels.kicker",
      "default": "Autumn / Winter 2026"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "t:labels.heading",
      "default": "Architectural Silhouettes"
    },
    {
      "type": "textarea",
      "id": "subheading_1",
      "label": "t:labels.subheading",
      "default": "Pure geometry and tailored volume rendered in Italian wool and cashmere."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "t:labels.button_label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:labels.button_link"
    },
    {
      "type": "header",
      "content": "t:labels.tile_2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_2",
      "label": "t:labels.mobile_image"
    },
    {
      "type": "text",
      "id": "kicker_2",
      "label": "t:labels.kicker",
      "default": "The Denim Atelier"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "t:labels.heading",
      "default": "Raw Japanese Selvage"
    },
    {
      "type": "textarea",
      "id": "subheading_2",
      "label": "t:labels.subheading",
      "default": "Shuttle-loom woven denim in sculptural everyday cuts."
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:labels.button_label",
      "default": "Discover Denim"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:labels.button_link"
    }
  ]
}
{% endschema %}
