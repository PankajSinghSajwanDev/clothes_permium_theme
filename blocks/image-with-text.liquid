{% doc %}
  Renders a luxury side-by-side image and narrative text block with reversible layout.
{% enddoc %}

{%- liquid
  assign layout_order = block.settings.layout | default: 'image_first'
-%}

<div class="image-with-text image-with-text--{{ layout_order }}" {{ block.shopify_attributes }}>
  <div class="image-with-text__inner">
    <div class="image-with-text__media">
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 1400 | image_tag:
          class: 'image-with-text__img',
          widths: '600, 900, 1200, 1400',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          alt: block.settings.heading | default: shop.name | escape
        }}
      {%- else -%}
        <div class="image-with-text__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="image-with-text__content">
      {%- if block.settings.kicker != blank -%}
        <span class="image-with-text__kicker">{{ block.settings.kicker }}</span>
      {%- endif -%}

      {%- if block.settings.heading != blank -%}
        <h2 class="image-with-text__heading">{{ block.settings.heading }}</h2>
      {%- endif -%}

      {%- if block.settings.text != blank -%}
        <div class="image-with-text__text">
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endif -%}

      {%- if block.settings.button_label != blank -%}
        <div class="image-with-text__cta">
          <a
            href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
            class="button button--secondary"
          >
            {{ block.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout_direction",
      "options": [
        {
          "value": "image_first",
          "label": "t:options.image_with_text.image_first"
        },
        {
          "value": "text_first",
          "label": "t:options.image_with_text.text_first"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker",
      "default": "Textile Provenance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Italian Double-Faced Cashmere"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.subheading",
      "default": "Spun in Biella, Italy from exceptionally fine fibers. Each piece is unlined to reveal the mastery of split-seam hand-finishing, providing featherweight warmth without stiffness."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Explore Outerwear"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ]
}
{% endschema %}
