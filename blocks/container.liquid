{% doc %}
  Wraps composed page content in a semantic HTML element. Every template
  composes its page through a container block: the block owns the outer
  layout element and renders the composed body via {{ content }}.

  @param {string} [tag] - HTML element for the wrapper. Default: 'section'.
  @param {string} [content] - The composed content to render inside the container.
  @param {string} [align] - Alignment override.

  @example Default section wrapper
  {% block 'container' %}
    <h1>{{ page.title }}</h1>
    {{ page.content }}
  {% endblock %}

  @example Override the wrapper element
  {% block 'container', tag: 'div' %}
    ...
  {% endblock %}
{% enddoc %}

{%- assign tag = tag | default: 'section' -%}
{%- assign container_alignment = align | default: block.settings.alignment -%}

<{{ tag }} class="block-container" style="--text-align: {{ container_alignment }};" {{ block.shopify_attributes }}>
  {{ content }}
</{{ tag }}>

{% schema %}
{
  "name": "t:general.container",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
