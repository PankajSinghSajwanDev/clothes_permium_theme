{% doc %}
  Renders a curated grid of collection tiles with atmospheric photography and titles.
{% enddoc %}

{%- liquid
  assign title = block.settings.title | default: 'sections.curated_editions' | t
  assign kicker = block.settings.kicker
-%}

<div class="collection-grid-section" {{ block.shopify_attributes }}>
  <div class="collection-grid__header">
    {%- if kicker != blank -%}
      <span class="collection-grid__kicker">{{ kicker }}</span>
    {%- endif -%}
    <h2 class="collection-grid__title">{{ title }}</h2>
  </div>

  <div class="collection-grid__items">
    {%- # Collection 1 -%}
    {%- if block.settings.collection_1 != blank -%}
      {%- assign col_1 = block.settings.collection_1 -%}
      <a href="{{ col_1.url }}" class="collection-tile">
        <div class="collection-tile__media">
          {%- assign img_1 = block.settings.image_1 | default: col_1.featured_image -%}
          {%- if img_1 != blank -%}
            {{ img_1 | image_url: width: 1000 | image_tag:
              class: 'collection-tile__image',
              widths: '400, 700, 1000',
              sizes: '(min-width: 990px) 33vw, 100vw',
              loading: 'lazy',
              alt: col_1.title | escape
            }}
          {%- else -%}
            <div class="collection-tile__placeholder">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          <div class="collection-tile__overlay"></div>
        </div>
        <div class="collection-tile__content">
          <h3 class="collection-tile__name">{{ col_1.title }}</h3>
          <span class="collection-tile__link-text">{{ 'sections.discover' | t }}</span>
        </div>
      </a>
    {%- endif -%}

    {%- # Collection 2 -%}
    {%- if block.settings.collection_2 != blank -%}
      {%- assign col_2 = block.settings.collection_2 -%}
      <a href="{{ col_2.url }}" class="collection-tile">
        <div class="collection-tile__media">
          {%- assign img_2 = block.settings.image_2 | default: col_2.featured_image -%}
          {%- if img_2 != blank -%}
            {{ img_2 | image_url: width: 1000 | image_tag:
              class: 'collection-tile__image',
              widths: '400, 700, 1000',
              sizes: '(min-width: 990px) 33vw, 100vw',
              loading: 'lazy',
              alt: col_2.title | escape
            }}
          {%- else -%}
            <div class="collection-tile__placeholder">
              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          <div class="collection-tile__overlay"></div>
        </div>
        <div class="collection-tile__content">
          <h3 class="collection-tile__name">{{ col_2.title }}</h3>
          <span class="collection-tile__link-text">{{ 'sections.discover' | t }}</span>
        </div>
      </a>
    {%- endif -%}

    {%- # Collection 3 -%}
    {%- if block.settings.collection_3 != blank -%}
      {%- assign col_3 = block.settings.collection_3 -%}
      <a href="{{ col_3.url }}" class="collection-tile">
        <div class="collection-tile__media">
          {%- assign img_3 = block.settings.image_3 | default: col_3.featured_image -%}
          {%- if img_3 != blank -%}
            {{ img_3 | image_url: width: 1000 | image_tag:
              class: 'collection-tile__image',
              widths: '400, 700, 1000',
              sizes: '(min-width: 990px) 33vw, 100vw',
              loading: 'lazy',
              alt: col_3.title | escape
            }}
          {%- else -%}
            <div class="collection-tile__placeholder">
              {{ 'collection-3' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          <div class="collection-tile__overlay"></div>
        </div>
        <div class="collection-tile__content">
          <h3 class="collection-tile__name">{{ col_3.title }}</h3>
          <span class="collection-tile__link-text">{{ 'sections.discover' | t }}</span>
        </div>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker",
      "default": "Curated Editions"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "default": "Shop By Category"
    },
    {
      "type": "header",
      "content": "t:labels.tile_1"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "t:labels.collection"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:labels.image"
    },
    {
      "type": "header",
      "content": "t:labels.tile_2"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "t:labels.collection"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:labels.image"
    },
    {
      "type": "header",
      "content": "t:labels.tile_3"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "t:labels.collection"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "t:labels.image"
    }
  ]
}
{% endschema %}
